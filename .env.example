# 复制为 .env 后按需填写；.env 不入库
# ===== 应用 =====
APP_NAME=personal-kb-rag
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 数据库 =====
# docker-compose 启动 postgres 时使用以下变量（密码必填）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_DB=personal_kb
POSTGRES_PORT=5432
# 后端异步连接串，账号/密码/库名需与上方 POSTGRES_* 保持一致
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/personal_kb

# ===== 登录鉴权（必填） =====
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_MINUTES=1440
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=请替换为强密码

# ===== 阿里云百炼 DashScope（未配置时 AI 接口返回友好提示） =====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4.1-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# ===== 文件上传 =====
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=20
